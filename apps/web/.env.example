# Public Firebase Web app configuration and Convex deployment URL.
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Set FIREBASE_PROJECT_ID and PULSO_BOOTSTRAP_ADMIN_EMAIL in the Convex deployment, not here.
# Keep CONVEX_DEPLOY_KEY in your deployment platform's sensitive environment variables.
# Set PITCH_DEMO_ENABLED=false in the Convex deployment (not a public browser variable).
# For a dedicated pitch deployment only, explicitly set it to true via Convex environment settings.
PITCH_DEMO_ENABLED=false
